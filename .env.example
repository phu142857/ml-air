# =============================================================================
# MLAir — single project-root configuration (edit this file only)
# =============================================================================
#
# **Guide:** docs/configuration.md
# **Do not copy to deploy/** — `mlair start|build|rebuild` reads this file from the repo root.
# On first run, `mlair start` creates `.env` here by merging this file + deploy/.env.infra.example.
#
# Policy / features / runtime knobs: Hub → Settings → Administration → Platform
#   (General, Features, Runtime, Observability) backed by L4 `system_settings`.
# Inspect the full normalized catalog: Platform → Environment
#   (`GET /v1/system/settings/catalog`).
# Inspect merged profile: `mlair config print`
#
# Layers:
#   L4  = editable in Hub (features.*, governance.*, identity.*, telemetry.*, runtime.*)
#   ENV = process / compose bootstrap (restart required; view-only in Environment catalog)
#   SECRET = credentials (masked in Hub; never patchable via API)

# --- A. Infrastructure (ENV / SECRET — restart) ---
# Quickstart (multi-container): postgres/redis service hostnames below.
# All-in-one (COMPOSE_FILE=deploy/docker-compose.allinone.yml): use 127.0.0.1 — see deploy/.env.infra.example.
ML_AIR_DATABASE_URL=postgresql://mlair:mlair@postgres:5432/mlair
ML_AIR_REDIS_URL=redis://redis:6379/0
ML_AIR_API_BASE_URL=http://api:8080
MLAIR_PORT=8080

# --- B. Secrets (SECRET — restart; Hub shows masked) ---
ML_AIR_IDENTITY_JWT_SECRET=mlair-dev-identity-jwt-secret-32bytes-minimum
ML_AIR_BOOTSTRAP_ADMIN_USERNAME=admin
ML_AIR_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
ML_AIR_SA_SCHEDULER_SECRET=mlair-dev-sa-scheduler-secret-change-me
ML_AIR_SA_EXECUTOR_SECRET=mlair-dev-sa-executor-secret-change-me
# External workers: create a Service Account in Hub → Identity → Service Accounts,
# then set ML_AIR_SERVICE_ACCOUNT_TOKEN or ML_AIR_SA_WORKER_SECRET in the worker process.
ML_AIR_MANIFEST_SIGNING_KEY=mlair-dev-manifest-signing-key
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
# Semantic realtime event signing (Hub WebSocket live updates).
# Default ML_AIR_SEMANTIC_EVENT_SIGNING=1 requires a key; without it the API refuses to start
# (mlair doctor FAIL) and skips publishes (log: realtime_publish_skip reason=signing_key_missing).
# Compose forwards these into the all-in-one / api container — set them here, not only in deploy/.
# Generate production key: openssl rand -hex 32
# Prefer toggling signing/validate via Hub Features once L4 is seeded; keys stay in .env.
ML_AIR_SEMANTIC_EVENT_SIGNING=1
ML_AIR_SEMANTIC_EVENT_SIGNING_KEY=mlair-dev-semantic-event-signing-key-change-me
ML_AIR_SEMANTIC_EVENT_ACTIVE_KEY_ID=v1
# ML_AIR_SEMANTIC_EVENT_SIGNING_KEYS_JSON={"v1":"old","v2":"new"}
# ML_AIR_SEMANTIC_EVENT_VALIDATE=0

# --- C. Storage (L4 runtime.* preferred after seed; env is bootstrap fallback) ---
ML_AIR_DATASET_ARTIFACT_ROOT=file:///mlair/artifacts/datasets
ML_AIR_DEFAULT_MODEL_ARTIFACT_ROOT=file:///mlair/artifacts/models

# --- D. Deployment mode ---
# Profile stays ENV (restart). Task execution / lease → L4 runtime.* in Hub Runtime.
MLAIR_PROFILE=development

# Task execution: internal = built-in executor in all-in-one; external = workers lease via POST /v1/tasks/lease.
# All-in-one compose defaults to external — set a worker VM or use internal for local-only dev.
ML_AIR_TASK_EXECUTION_MODE=external
ML_AIR_TASK_LEASE_SECONDS=300

# All-in-one loopback overrides (uncomment when COMPOSE_FILE=deploy/docker-compose.allinone.yml).
# Quickstart examples use postgres:/redis: hostnames in section A above.
# ML_AIR_DATABASE_URL=postgresql://mlair:mlair@127.0.0.1:5432/mlair?client_encoding=utf8
# ML_AIR_REDIS_URL=redis://127.0.0.1:6379/0
# ML_AIR_API_BASE_URL=http://127.0.0.1:18080
# Use literal ports below — do not leave ${VAR:-default} unexpanded (podman-compose crash).
# ML_AIR_SCHEDULER_METRICS_PORT=9102
# ML_AIR_EXECUTOR_METRICS_PORT=9103
# ML_AIR_REALTIME_METRICS_PORT=9104

# Optional all-in-one sidecars (MinIO / Prometheus / Grafana) — off by default.
# Enable in mlair.yaml → infra (recommended) or MLAIR_INFRA_* keys in `.env` (see deploy/.env.infra.example).
# See docs/configuration.md § Optional infra sidecars.

# --- E. Image / compose (ENV — restart) ---
MLAIR_IMAGE=ml-air:latest
MLAIR_API_IMAGE=ml-air-api:latest
MLAIR_SCHEDULER_IMAGE=ml-air-scheduler:latest
MLAIR_EXECUTOR_IMAGE=ml-air-executor:latest
MLAIR_FRONTEND_IMAGE=ml-air-frontend:latest
MLAIR_REALTIME_IMAGE=ml-air-realtime:latest
COMPOSE_FILE=deploy/docker-compose.allinone.yml
MLAIR_COMPOSE_FILE=deploy/docker-compose.allinone.yml

# --- Frontend / browser URLs (all-in-one; not counted in ~20 server contract) ---
# Leave empty for same-origin: Hub + GET /v1/runtime-config derive API/WS from the Host
# you open in the browser (localhost, LAN IP, or ingress hostname — no rebuild required).
# Set explicitly only for split-host or reverse-proxy deploys — see docs/runbooks/production-wss-ingress.md.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MLAIR_REALTIME_WS=
MLAIR_NEXT_INTERNAL_API_URL=http://api:8080

# --- F. Policy feature aliases (L4 features.* — Hub Features tab) ---
# After system_settings is seeded, Hub L4 wins unless ML_AIR_CONFIG_ACCEPT_POLICY_ENV=1.
# Keep aliases here only for bootstrap / rollback. Full list: Platform → Environment.
# ML_AIR_USAGE_TRACKING_ENABLED=1
# ML_AIR_OTEL_ENABLED=1
# ML_AIR_ENABLE_SERVING_SLOTS_HTTP=1
# ML_AIR_TENANT_QUOTA_ENFORCE=1
# ML_AIR_SKIP_APPROVAL_FOR_PROMOTE=1

# --- F1. Phase 3–6 feature aliases (optional bootstrap; see deploy/.env.infra.example) ---
# Hub L4 `features.*` wins after seed unless ML_AIR_CONFIG_ACCEPT_POLICY_ENV=1.
# Full catalog: Platform → Environment (`GET /v1/system/settings/catalog`).

# =============================================================================
# MLAir — deployment environment contract
# =============================================================================
#
# .env answers: "Where does the stack run, and how do services connect?"
# It should NOT be the long-term home for lifecycle semantics or tenant policy.
#
# Config layers (target architecture):
#
#   Layer 1 — Deployment (.env)     infra, secrets, ports, bootstrap, global toggles
#   Layer 2 — System runtime        GET /v1/runtime-config (today: env-backed;
#                                   target: DB system_runtime_config + admin UI)
#   Layer 3 — Tenant policy         tenant_quotas, webhook subs, governance APIs
#   Layer 4 — Domain / pipeline     dataset policies, pipeline YAML, model registry
#
# Section 7 below holds transitional flags still read from env at process start.
# Many are mirrored on GET /v1/runtime-config → features.* for Hub/clients.
# Prefer moving high-priority semantics (strict dataset version, readiness fallback,
# product feature flags) to Layer 2 DB config over time.
#
# CI: compose refs must appear here (make test-env-sync).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Host ports (Docker Compose → container)
# -----------------------------------------------------------------------------
ML_AIR_FRONTEND_PORT=38080
ML_AIR_API_PORT=8080
ML_AIR_SCHEDULER_METRICS_PORT=9102
# Wave 1: Redis tick lock when running multiple scheduler replicas (default on).
ML_AIR_SCHEDULER_TICK_LOCK=1
ML_AIR_SCHEDULER_WORKER_ID=
ML_AIR_EXECUTOR_METRICS_PORT=9103
ML_AIR_REDIS_PORT=36379
ML_AIR_POSTGRES_PORT=35432
ML_AIR_MINIO_API_PORT=9000
ML_AIR_MINIO_CONSOLE_PORT=9001
ML_AIR_PROMETHEUS_PORT=39090
ML_AIR_GRAFANA_PORT=33000
MLAIR_REALTIME_PORT=8001
ML_AIR_REALTIME_METRICS_PORT=9104
# Optional --profile traces (Jaeger / Tempo)
ML_AIR_JAEGER_UI_PORT=16686
ML_AIR_JAEGER_OTLP_GRPC_PORT=4317
ML_AIR_TEMPO_HTTP_PORT=3200
ML_AIR_TEMPO_OTLP_GRPC_PORT=4327

# -----------------------------------------------------------------------------
# 2. Infrastructure connections
# -----------------------------------------------------------------------------
ML_AIR_REDIS_URL=redis://redis:6379/0
ML_AIR_DATABASE_URL=postgresql://mlair:mlair@postgres:5432/mlair
ML_AIR_API_BASE_URL=http://api:8080
# API only: Private Network Access preflight (browser → loopback API). Default on.
ML_AIR_CORS_ALLOW_PRIVATE_NETWORK=1

# -----------------------------------------------------------------------------
# 3. Secrets & authentication
# -----------------------------------------------------------------------------
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
ML_AIR_TRACKING_TOKEN=maintainer-token
# Optional advanced auth
ML_AIR_AUTH_TOKENS_JSON=
ML_AIR_JWT_ISSUER=
ML_AIR_JWT_AUDIENCE=
ML_AIR_JWT_JWKS_URL=
ML_AIR_JWT_JWKS_CACHE_TTL_SECONDS=300
ML_AIR_WORKER_TOKEN=

# Manifest / semantic event signing keys (Layer 1 secrets; rotation: docs/guides/rotate-keys.md)
ML_AIR_MANIFEST_SIGNING_KEY=mlair-dev-manifest-signing-key
ML_AIR_MANIFEST_ACTIVE_KEY_ID=v1
ML_AIR_MANIFEST_SIGNING_KEYS_JSON={"v1":"mlair-dev-manifest-signing-key"}
ML_AIR_MANIFEST_KEY_PROVIDER=env
ML_AIR_MANIFEST_MANAGED_KEYS_FILE=deploy/security/manifest-keys.local.json
ML_AIR_MANIFEST_STRICT_KEY_LIFECYCLE=0
ML_AIR_MANIFEST_ALLOWED_KEY_IDS=
ML_AIR_MANIFEST_SIGNING_ALGORITHM=hmac-sha256
ML_AIR_MANIFEST_ED25519_PRIVATE_KEY=
ML_AIR_MANIFEST_ED25519_PRIVATE_KEYS_JSON=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEY=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEYS_JSON=
ML_AIR_SEMANTIC_EVENT_SIGNING_KEY=
ML_AIR_SEMANTIC_EVENT_ACTIVE_KEY_ID=v1
ML_AIR_SEMANTIC_EVENT_SIGNING_KEYS_JSON=

# -----------------------------------------------------------------------------
# 4. Storage roots (persistent volumes in Docker)
# -----------------------------------------------------------------------------
ML_AIR_DEFAULT_MODEL_ARTIFACT_ROOT=file:///mlair/artifacts/models
ML_AIR_DATASET_ARTIFACT_ROOT=file:///mlair/artifacts/datasets

# -----------------------------------------------------------------------------
# 5. Observability & logging
# -----------------------------------------------------------------------------
ML_AIR_LOG_LEVEL=INFO
ML_AIR_OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME_API=mlair-api
OTEL_SERVICE_NAME_SCHEDULER=mlair-scheduler
OTEL_SERVICE_NAME_EXECUTOR=mlair-executor
OTEL_SERVICE_NAME_REALTIME=mlair-realtime
# Browser Jaeger link on /lifecycle (user-reachable URL, e.g. http://localhost:16686)
ML_AIR_JAEGER_UI_URL=

# -----------------------------------------------------------------------------
# 6. Realtime transport (Redis pub/sub + gateway — always on; not configurable)
# -----------------------------------------------------------------------------
ML_AIR_EVENT_OUTBOX=0
ML_AIR_EVENT_OUTBOX_DRAIN_INTERVAL_SEC=0
# Phase 4: Redis Streams durable bus + execution projection (see docs/guides/execution-realtime-architecture.md)
ML_AIR_EVENT_STREAM=0
ML_AIR_EVENT_STREAM_GLOBAL_FANOUT=0
ML_AIR_EVENT_STREAM_MAXLEN=50000
ML_AIR_EVENT_STREAM_GLOBAL_MAXLEN=200000
ML_AIR_EXECUTION_PROJECTION=0
# Realtime: consume global durable stream (multi-replica fan-out; requires ML_AIR_EVENT_STREAM_GLOBAL_FANOUT=1 on publishers)
MLAIR_REALTIME_STREAM_FANOUT=0
MLAIR_REALTIME_STREAM_START_ID=$
ML_AIR_SEMANTIC_EVENT_SIGNING=0
ML_AIR_SEMANTIC_EVENT_VALIDATE=0

# -----------------------------------------------------------------------------
# 7. System overrides (transitional — env at startup; target: runtime-config DB)
# -----------------------------------------------------------------------------
# Subset exposed read-only: GET /v1/runtime-config → features.*, observability.*, build.*
# Do NOT use .env for per-tenant policy (quotas, webhook URLs per tenant) — use APIs/DB.

# --- 7a. Lifecycle & readiness semantics (migrate → system_runtime_config) ---
# Staging/prod: copy deploy/env/staging-strict.env.example or production-strict.env.example
# Runbook: docs/runbooks/production-strict-lifecycle.md · Sunset: docs/runbooks/legacy-compat-sunset.md
# runtime-config.features.strict_dataset_version_required
ML_AIR_STRICT_DATASET_VERSION_REQUIRED=1
# runtime-config.features.strict_dataset_version_all_post_runs (default on — blanket pin on generic POST run paths)
ML_AIR_STRICT_DATASET_VERSION_ALL_POST_RUNS=1
# runtime-config.observability.grafana_ui_url (Hub lifecycle metrics links)
ML_AIR_GRAFANA_URL=http://localhost:33000
# runtime-config.features.readiness_allow_legacy_fallback
ML_AIR_READINESS_ALLOW_LEGACY_FALLBACK=0
ML_AIR_REQUIRE_DECLARED_DATASET_INPUTS=0
ML_AIR_VALIDATE_DATASET_VERSION_CHECKSUM=0
ML_AIR_WARN_IMPLICIT_DATASET_HEAD=0

# --- 7b. Migration / compatibility (temporary; tag remove_after in code when adding) ---
# TODO(remove): lineage vN allocator cutover
ML_AIR_LINEAGE_LEGACY_DEFAULT_VERSION_LABEL=0

# --- 7c. Product & Hub feature flags (migrate → feature_flags / runtime-config DB) ---
ML_AIR_ENVIRONMENT=dev
ML_AIR_DEFAULT_TENANT=default
ML_AIR_DEFAULT_PROJECT=default_project
# Public browser API URL (optional). Empty = infer from Host / X-Forwarded-* on GET /v1/runtime-config (ALB-safe).
ML_AIR_RUNTIME_API_BASE_URL=
# Browser WebSocket URL (optional). Empty = derive wss/ws from inferred api_base_url (same host as ALB).
ML_AIR_RUNTIME_REALTIME_BASE_URL=
# Dev-only default when API cannot infer host (local quickstart). Omit on AWS — use same-origin + ALB headers.
ML_AIR_RUNTIME_REALTIME_DEFAULT_URL=ws://localhost:8001
ML_AIR_FRONTEND_VERSION=
ML_AIR_FRONTEND_COMMIT=
# runtime-config.features.dataset_hub_v2
ML_AIR_FEATURE_DATASET_HUB_V2=1
# runtime-config.features.scope_debug_panel
ML_AIR_FEATURE_SCOPE_DEBUG_PANEL=0
# runtime-config.features.serving_slots_http
ML_AIR_ENABLE_SERVING_SLOTS_HTTP=0
ML_AIR_SCOPE_OVERRIDE_TTL_SECONDS=0

# --- 7d. Governance promote policy (migrate → promotion policy table / runtime-config) ---
# Model promotion / rollback (Wave 2 — see docs/guides/model-promotion-governance.md)
ML_AIR_PROMOTION_STAGE_ORDER=staging,production
ML_AIR_PROMOTION_ALLOW_SKIP_STAGES=0
ML_AIR_ROLLBACK_ENABLED=1
ML_AIR_ROLLBACK_REQUIRES_APPROVAL=0
# runtime-config: promotion_governance_runtime()
ML_AIR_SKIP_APPROVAL_FOR_PROMOTE=
ML_AIR_PROMOTION_APPROVAL_STAGES=production
# runtime-config.features.tenant_quota_enforcement — enforce via tenant_quotas API
ML_AIR_TENANT_QUOTA_ENFORCE=0
# Internal concurrent task slots per project
# ML_AIR_TENANT_QUOTA_DEFAULT_MAX_PARALLEL_TASKS=1000

# --- 7e. Scheduler & worker runtime tuning (global infra; tenant-specific → policy DB) ---
ML_AIR_TASK_EXECUTION_MODE=internal
ML_AIR_TASK_LEASE_SECONDS=30
ML_AIR_LEASE_REAP_INTERVAL_SECONDS=5
ML_AIR_TRIGGER_POLICY_TICK_SECONDS=30
ML_AIR_DATASET_MATERIALIZATION_TICK_SECONDS=30
ML_AIR_DATASET_MATERIALIZATION_TICK_LIMIT=50
ML_AIR_PLUGIN_TIMEOUT_SECONDS=120
ML_AIR_PLUGIN_RUNNER_MODULE=mlair_runner
ML_AIR_HTTP_TASK_ALLOWED_HOSTS=
ML_AIR_HTTP_TASK_TEMPLATES=1

# --- 7f. Replay & execution security policy ---
ML_AIR_REPLAY_REQUIRE_ARTIFACT_EVIDENCE=1
ML_AIR_REPLAY_REQUIRE_CHECKSUM=0
ML_AIR_REPLAY_REQUIRE_SIGNED_MANIFEST=0

# --- 7g. Semantic webhook delivery (global allowlist; per-tenant URLs in DB) ---
ML_AIR_SEMANTIC_WEBHOOK_DELIVERY=0
ML_AIR_WEBHOOK_ALLOWED_HOSTS=
ML_AIR_SEMANTIC_WEBHOOK_TIMEOUT_SECONDS=10
ML_AIR_SEMANTIC_WEBHOOK_MAX_ATTEMPTS=3
ML_AIR_SEMANTIC_WEBHOOK_RETRY_BACKOFF_MS=250
ML_AIR_SEMANTIC_WEBHOOK_DEDUPE=0

# -----------------------------------------------------------------------------
# 8. External integrations (deployment-level URLs)
# -----------------------------------------------------------------------------
MLAIR_MODEL_PROMOTE_WEBHOOK_URL=
MLAIR_MODEL_PROMOTE_WEBHOOK_BEARER_TOKEN=
MLAIR_MODEL_PROMOTE_WEBHOOK_TIMEOUT_SECONDS=15

# Hub `/` redirect: datasets | lifecycle | dashboard | models (API runtime-config hub_default_route)
ML_AIR_HUB_DEFAULT_ROUTE=datasets

# -----------------------------------------------------------------------------
# 9. Frontend (Next.js — browser + server proxy)
# Realtime push + polling fallback are ON by default; override URLs only for custom deploy topology.
# -----------------------------------------------------------------------------
# Local dev only: browser calls API on host port. Production image build: leave empty (same-origin /v1 proxy).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
MLAIR_NEXT_INTERNAL_API_URL=http://api:8080
# Optional build-time override (runtime-config + location inference usually sufficient).
NEXT_PUBLIC_MLAIR_REALTIME_WS=
# NEXT_PUBLIC_MLAIR_PIPELINE_EXECUTION_GATE_DEFAULT=open
# NEXT_PUBLIC_MLAIR_TRAIN_TELEMETRY_URL=https://your-collector.example/mlair-train-intent
# NEXT_PUBLIC_MLAIR_TRAIN_TELEMETRY_DEBUG=1

# -----------------------------------------------------------------------------
# 10. CLI / local dev helpers
# -----------------------------------------------------------------------------
ML_AIR_BASE_URL=http://localhost:8080
ML_AIR_TENANT_ID=default
ML_AIR_PROJECT_ID=default_project
ML_AIR_TENANT=default
ML_AIR_PROJECT=default_project
ML_AIR_TOKEN=maintainer-token
COMPOSE_FILE=deploy/docker-compose.quickstart.yml

# -----------------------------------------------------------------------------
# 11. Image bootstrap credentials (Compose only — not MLAir application config)
# -----------------------------------------------------------------------------
POSTGRES_USER=mlair
POSTGRES_PASSWORD=mlair
POSTGRES_DB=mlair
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# -------------------------------------------------------------------
# Core service connections
# -------------------------------------------------------------------
ML_AIR_REDIS_URL=redis://redis:6379/0
ML_AIR_DATABASE_URL=postgresql://mlair:mlair@postgres:5432/mlair
ML_AIR_API_BASE_URL=http://api:8080
# Default artifact root used when user creates model version
# without explicitly providing artifact_uri.
ML_AIR_DEFAULT_MODEL_ARTIFACT_ROOT=file:///mlair/artifacts/models
# Uploaded dataset CSVs; must be on persistent storage in Docker (volume mount this path).
ML_AIR_DATASET_ARTIFACT_ROOT=file:///mlair/artifacts/datasets

# -------------------------------------------------------------------
# Frontend runtime (optional, for Next.js)
# -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# -------------------------------------------------------------------
# API auth/security
# -------------------------------------------------------------------
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
ML_AIR_TRACKING_TOKEN=maintainer-token

# Optional advanced auth settings
ML_AIR_AUTH_TOKENS_JSON=
ML_AIR_JWT_ISSUER=
ML_AIR_JWT_AUDIENCE=
ML_AIR_JWT_JWKS_URL=
ML_AIR_JWT_JWKS_CACHE_TTL_SECONDS=300

# -------------------------------------------------------------------
# Model promote webhook (API only; optional)
# POST JSON to MLAIR_MODEL_PROMOTE_WEBHOOK_URL with Bearer when a model version is promoted.
# -------------------------------------------------------------------
MLAIR_MODEL_PROMOTE_WEBHOOK_URL=
MLAIR_MODEL_PROMOTE_WEBHOOK_BEARER_TOKEN=
MLAIR_MODEL_PROMOTE_WEBHOOK_TIMEOUT_SECONDS=15

# When unset or 0, promote to production requires approval_status=approved on that version.
# Set to 1 only for local/dev if you want to skip the gate (quickstart compose defaults to 1).
ML_AIR_SKIP_APPROVAL_FOR_PROMOTE=

# -------------------------------------------------------------------
# Replay + manifest hardening
# -------------------------------------------------------------------
ML_AIR_REPLAY_REQUIRE_ARTIFACT_EVIDENCE=1
ML_AIR_REPLAY_REQUIRE_CHECKSUM=0
ML_AIR_REPLAY_REQUIRE_SIGNED_MANIFEST=0
ML_AIR_MANIFEST_SIGNING_KEY=mlair-dev-manifest-signing-key
ML_AIR_MANIFEST_ACTIVE_KEY_ID=v1
ML_AIR_MANIFEST_SIGNING_KEYS_JSON={"v1":"mlair-dev-manifest-signing-key"}
ML_AIR_MANIFEST_KEY_PROVIDER=env
ML_AIR_MANIFEST_MANAGED_KEYS_FILE=deploy/security/manifest-keys.local.json
ML_AIR_MANIFEST_STRICT_KEY_LIFECYCLE=0
ML_AIR_MANIFEST_ALLOWED_KEY_IDS=
ML_AIR_MANIFEST_SIGNING_ALGORITHM=hmac-sha256
ML_AIR_MANIFEST_ED25519_PRIVATE_KEY=
ML_AIR_MANIFEST_ED25519_PRIVATE_KEYS_JSON=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEY=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEYS_JSON=

# -------------------------------------------------------------------
# Executor/plugin tuning (optional)
# -------------------------------------------------------------------
ML_AIR_PLUGIN_TIMEOUT_SECONDS=120
ML_AIR_PLUGIN_RUNNER_MODULE=mlair_runner
ML_AIR_LOG_LEVEL=INFO

# -------------------------------------------------------------------
# External worker execution (optional; requires migration 0011)
# Set ML_AIR_TASK_EXECUTION_MODE=external on API + scheduler for pull/lease workers.
# -------------------------------------------------------------------
ML_AIR_TASK_EXECUTION_MODE=internal
# Dedicated Bearer for POST /v1/tasks/lease|heartbeat|complete|fail (optional).
ML_AIR_WORKER_TOKEN=
ML_AIR_TASK_LEASE_SECONDS=30
ML_AIR_LEASE_REAP_INTERVAL_SECONDS=5
# Scheduler periodic loops
ML_AIR_TRIGGER_POLICY_TICK_SECONDS=30
ML_AIR_DATASET_MATERIALIZATION_TICK_SECONDS=30
# Per tenant/project scope when scheduler calls POST .../datasets/buffer/materialize-scheduled
ML_AIR_DATASET_MATERIALIZATION_TICK_LIMIT=50
# Readiness v2 cutover guard:
# 1 = allow fallback to datasets.current_size when no materialized version exists (compat mode)
# 0 = require materialized dataset version for readiness evaluation
ML_AIR_READINESS_ALLOW_LEGACY_FALLBACK=0

# -------------------------------------------------------------------
# CLI/test helpers (optional)
# -------------------------------------------------------------------
ML_AIR_BASE_URL=http://localhost:8080
ML_AIR_TENANT_ID=default
ML_AIR_PROJECT_ID=default_project
ML_AIR_TENANT=default
ML_AIR_PROJECT=default_project
ML_AIR_TOKEN=maintainer-token
COMPOSE_FILE=deploy/docker-compose.quickstart.yml

# -------------------------------------------------------------------
# Ports (host)
# -------------------------------------------------------------------
ML_AIR_FRONTEND_PORT=38080
ML_AIR_API_PORT=8080
ML_AIR_SCHEDULER_METRICS_PORT=9102
ML_AIR_EXECUTOR_METRICS_PORT=9103
ML_AIR_REDIS_PORT=36379
ML_AIR_POSTGRES_PORT=35432
ML_AIR_MINIO_API_PORT=9000
ML_AIR_MINIO_CONSOLE_PORT=9001
ML_AIR_PROMETHEUS_PORT=39090
ML_AIR_GRAFANA_PORT=33000

# -------------------------------------------------------------------
# Postgres bootstrap
# -------------------------------------------------------------------
POSTGRES_USER=mlair
POSTGRES_PASSWORD=mlair
POSTGRES_DB=mlair

# -------------------------------------------------------------------
# MinIO bootstrap
# -------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword

# -------------------------------------------------------------------
# Grafana bootstrap
# -------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# =============================================================================
# MLAir — deployment environment contract
# =============================================================================
#
# **Primary config guide:** docs/configuration.md (profiles, mlair.yaml, CLI)
# Use `mlair config print` to see merged settings. This file is the Docker/compose
# env layer for infrastructure URLs and secrets.
#
# Feature flags default to **1 (on)**. Set **0** in `.env` to disable a capability.
#

# -----------------------------------------------------------------------------
# 1. Host ports (Docker Compose → container)
# -----------------------------------------------------------------------------
ML_AIR_FRONTEND_PORT=38080
ML_AIR_API_PORT=8080
ML_AIR_SCHEDULER_METRICS_PORT=9102
ML_AIR_SCHEDULER_TICK_LOCK=1
ML_AIR_SCHEDULER_WORKER_ID=
ML_AIR_EXECUTOR_METRICS_PORT=9103
ML_AIR_REDIS_PORT=36379
ML_AIR_POSTGRES_PORT=35432
ML_AIR_MINIO_API_PORT=9000
ML_AIR_MINIO_CONSOLE_PORT=9001
ML_AIR_PROMETHEUS_PORT=39090
ML_AIR_GRAFANA_PORT=33000
MLAIR_REALTIME_PORT=8001
ML_AIR_REALTIME_METRICS_PORT=9104
MLAIR_PORT=8080

# -----------------------------------------------------------------------------
# 2. Infrastructure connections
# -----------------------------------------------------------------------------
ML_AIR_REDIS_URL=redis://redis:6379/0
ML_AIR_DATABASE_URL=postgresql://mlair:mlair@postgres:5432/mlair
ML_AIR_API_BASE_URL=http://api:8080
ML_AIR_CORS_ALLOW_PRIVATE_NETWORK=1

# -----------------------------------------------------------------------------
# 3. Secrets & authentication
# -----------------------------------------------------------------------------
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
ML_AIR_TRACKING_TOKEN=maintainer-token
ML_AIR_AUTH_TOKENS_JSON=
ML_AIR_JWT_ISSUER=
ML_AIR_JWT_AUDIENCE=
ML_AIR_JWT_JWKS_URL=
ML_AIR_JWT_JWKS_CACHE_TTL_SECONDS=300
ML_AIR_WORKER_TOKEN=

# Manifest / semantic event signing keys (Layer 1 secrets; rotation: docs/guides/rotate-keys.md)
ML_AIR_MANIFEST_SIGNING_KEY=mlair-dev-manifest-signing-key
ML_AIR_MANIFEST_ACTIVE_KEY_ID=v1
ML_AIR_MANIFEST_SIGNING_KEYS_JSON={"v1":"mlair-dev-manifest-signing-key"}
ML_AIR_MANIFEST_KEY_PROVIDER=env
ML_AIR_MANIFEST_MANAGED_KEYS_FILE=deploy/security/manifest-keys.local.json
ML_AIR_MANIFEST_STRICT_KEY_LIFECYCLE=1
ML_AIR_MANIFEST_ALLOWED_KEY_IDS=
ML_AIR_MANIFEST_SIGNING_ALGORITHM=hmac-sha256
ML_AIR_MANIFEST_ED25519_PRIVATE_KEY=
ML_AIR_MANIFEST_ED25519_PRIVATE_KEYS_JSON=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEY=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEYS_JSON=
ML_AIR_SEMANTIC_EVENT_SIGNING_KEY=
ML_AIR_SEMANTIC_EVENT_ACTIVE_KEY_ID=v1
ML_AIR_SEMANTIC_EVENT_SIGNING_KEYS_JSON=

# -----------------------------------------------------------------------------
# 4. Storage roots (persistent volumes in Docker)
# -----------------------------------------------------------------------------
ML_AIR_DEFAULT_MODEL_ARTIFACT_ROOT=file:///mlair/artifacts/models
ML_AIR_DATASET_ARTIFACT_ROOT=file:///mlair/artifacts/datasets

# -----------------------------------------------------------------------------
# 5. Observability & logging
# -----------------------------------------------------------------------------
ML_AIR_LOG_LEVEL=INFO
ML_AIR_OTEL_ENABLED=1
OTEL_SERVICE_NAME_API=mlair-api
OTEL_SERVICE_NAME_SCHEDULER=mlair-scheduler
OTEL_SERVICE_NAME_EXECUTOR=mlair-executor
OTEL_SERVICE_NAME_REALTIME=mlair-realtime
ML_AIR_GRAFANA_URL=http://localhost:33000

# -----------------------------------------------------------------------------
# 6. Realtime transport & durable events
# -----------------------------------------------------------------------------
ML_AIR_EVENT_OUTBOX=1
ML_AIR_EVENT_OUTBOX_DRAIN_INTERVAL_SEC=5
ML_AIR_EVENT_STREAM=1
ML_AIR_EVENT_STREAM_GLOBAL_FANOUT=1
ML_AIR_EVENT_STREAM_MAXLEN=50000
ML_AIR_EVENT_STREAM_GLOBAL_MAXLEN=200000
ML_AIR_EVENT_REPLAY_BUFFER_SIZE=1000
ML_AIR_EXECUTION_PROJECTION=1
MLAIR_REALTIME_STREAM_FANOUT=1
MLAIR_REALTIME_STREAM_START_ID=$
MLAIR_REALTIME_PING_SECONDS=30
MLAIR_REALTIME_MAX_PENDING_SENDS=64
MLAIR_REALTIME_COALESCE_MS=150
MLAIR_REALTIME_STREAM_BLOCK_MS=1000
ML_AIR_SEMANTIC_EVENT_SIGNING=1
ML_AIR_SEMANTIC_EVENT_VALIDATE=1

# -----------------------------------------------------------------------------
# 7. System overrides (transitional — env at startup; target: runtime-config DB)
# -----------------------------------------------------------------------------
# Subset exposed read-only: GET /v1/runtime-config → features.*, observability.*, build.*
# Do NOT use .env for per-tenant policy (quotas, webhook URLs per tenant) — use APIs/DB.

# --- 7a. Lifecycle & readiness semantics ---
ML_AIR_STRICT_DATASET_VERSION_REQUIRED=1
ML_AIR_STRICT_DATASET_VERSION_ALL_POST_RUNS=1
ML_AIR_LIFECYCLE_WEBHOOK_URL=
ML_AIR_LIFECYCLE_WEBHOOK_HMAC_SECRET=
ML_AIR_LIFECYCLE_WEBHOOK_BEARER_TOKEN=
ML_AIR_LIFECYCLE_WEBHOOK_TIMEOUT_SECONDS=15
ML_AIR_READINESS_ALLOW_LEGACY_FALLBACK=1
ML_AIR_READINESS_ASYNC_QUEUE=1
ML_AIR_READINESS_QUEUE_DRAIN_INTERVAL_SEC=2
ML_AIR_REQUIRE_DECLARED_DATASET_INPUTS=1
ML_AIR_VALIDATE_DATASET_VERSION_CHECKSUM=1
ML_AIR_WARN_IMPLICIT_DATASET_HEAD=1

# --- 7b. Migration / compatibility ---
ML_AIR_LINEAGE_LEGACY_DEFAULT_VERSION_LABEL=1

# --- 7c. Run environment capture (runs.environment on POST /runs) ---
ML_AIR_DOCKER_IMAGE=
ML_AIR_GIT_ROOT=
ML_AIR_CAPTURE_PIP_FREEZE=1
ML_AIR_RANDOM_SEED=
MLAIR_SOURCE_COMMIT=
MLAIR_SOURCE_BRANCH=
MLAIR_IMAGE_REF=
ML_AIR_SOURCE_COMMIT=
ML_AIR_SOURCE_BRANCH=

# --- 7d. Product & Hub feature flags ---
ML_AIR_ENVIRONMENT=dev
ML_AIR_DEFAULT_TENANT=default
ML_AIR_DEFAULT_PROJECT=default_project
ML_AIR_RUNTIME_API_BASE_URL=
ML_AIR_RUNTIME_REALTIME_BASE_URL=
ML_AIR_RUNTIME_REALTIME_DEFAULT_URL=ws://localhost:8080/ws
ML_AIR_FRONTEND_VERSION=
ML_AIR_FRONTEND_COMMIT=
ML_AIR_FEATURE_DATASET_HUB_V2=1
ML_AIR_FEATURE_SCOPE_DEBUG_PANEL=1
ML_AIR_ENABLE_SERVING_SLOTS_HTTP=1
ML_AIR_SCOPE_OVERRIDE_TTL_SECONDS=0
ML_AIR_DATASET_RETENTION_POLICIES=1
ML_AIR_DATASET_RETENTION_ALLOW_APPLY=1
ML_AIR_DATASET_RETENTION_DEFAULT_MAX_VERSIONS=50
ML_AIR_HTTP_PIPELINE_TASKS=1
ML_AIR_HTTP_TASK_TEMPLATES=1
ML_AIR_VALIDATE_PLUGIN_EXISTS_ON_CREATE=1
MLAIR_PLUGIN_VERSION_ENFORCE=1

# --- 7e. Governance promote policy ---
ML_AIR_PROMOTION_STAGE_ORDER=staging,production
ML_AIR_PROMOTION_ALLOW_SKIP_STAGES=1
ML_AIR_ROLLBACK_ENABLED=1
ML_AIR_ROLLBACK_REQUIRES_APPROVAL=1
ML_AIR_SKIP_APPROVAL_FOR_PROMOTE=1
ML_AIR_PROMOTION_APPROVAL_STAGES=production
ML_AIR_TENANT_QUOTA_ENFORCE=1

# --- 7f. Scheduler & worker runtime tuning ---
ML_AIR_TASK_EXECUTION_MODE=internal
ML_AIR_TASK_LEASE_SECONDS=30
ML_AIR_LEASE_REAP_INTERVAL_SECONDS=5
ML_AIR_USAGE_TRACKING_ENABLED=1
ML_AIR_RESOURCE_MONITOR_ENABLED=1
ML_AIR_RESOURCE_SAMPLE_INTERVAL=1
ML_AIR_RESOURCE_FLUSH_INTERVAL=1
ML_AIR_TRIGGER_POLICY_TICK_SECONDS=30
ML_AIR_DATASET_MATERIALIZATION_TICK_SECONDS=30
ML_AIR_DATASET_MATERIALIZATION_TICK_LIMIT=50
ML_AIR_PLUGIN_TIMEOUT_SECONDS=120
ML_AIR_PLUGIN_RUNNER_MODULE=mlair_runner
ML_AIR_HTTP_TASK_ALLOWED_HOSTS=
ML_AIR_REFERENCE_TASK_SLEEP_MS=

# --- 7g. Replay & execution security policy ---
ML_AIR_REPLAY_REQUIRE_ARTIFACT_EVIDENCE=1
ML_AIR_REPLAY_REQUIRE_CHECKSUM=1
ML_AIR_REPLAY_REQUIRE_SIGNED_MANIFEST=1

# --- 7h. Semantic webhook delivery ---
ML_AIR_SEMANTIC_WEBHOOK_DELIVERY=1
ML_AIR_WEBHOOK_ALLOWED_HOSTS=
ML_AIR_SEMANTIC_WEBHOOK_TIMEOUT_SECONDS=10
ML_AIR_SEMANTIC_WEBHOOK_MAX_ATTEMPTS=3
ML_AIR_SEMANTIC_WEBHOOK_RETRY_BACKOFF_MS=250
ML_AIR_SEMANTIC_WEBHOOK_DEDUPE=1

# -----------------------------------------------------------------------------
# 8. External integrations (deployment-level URLs)
# -----------------------------------------------------------------------------
MLAIR_MODEL_PROMOTE_WEBHOOK_URL=
MLAIR_MODEL_PROMOTE_WEBHOOK_BEARER_TOKEN=
MLAIR_MODEL_PROMOTE_WEBHOOK_TIMEOUT_SECONDS=15
ML_AIR_HUB_DEFAULT_ROUTE=datasets

# -----------------------------------------------------------------------------
# 9. Frontend (Next.js — browser + server proxy)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
MLAIR_NEXT_INTERNAL_API_URL=http://api:8080
NEXT_PUBLIC_MLAIR_REALTIME_WS=ws://localhost:8001
# NEXT_PUBLIC_MLAIR_PIPELINE_EXECUTION_GATE_DEFAULT=open
# NEXT_PUBLIC_MLAIR_TRAIN_TELEMETRY_URL=https://your-collector.example/mlair-train-intent
# NEXT_PUBLIC_MLAIR_TRAIN_TELEMETRY_DEBUG=1
# MLAIR_CSP_REPORT_ONLY=0

# -----------------------------------------------------------------------------
# 10. CLI / local dev helpers
# -----------------------------------------------------------------------------
ML_AIR_BASE_URL=http://localhost:8080
ML_AIR_TENANT_ID=default
ML_AIR_PROJECT_ID=default_project
ML_AIR_TENANT=default
ML_AIR_PROJECT=default_project
ML_AIR_TOKEN=maintainer-token
COMPOSE_FILE=deploy/docker-compose.quickstart.yml
MLAIR_COMPOSE_FILE=deploy/docker-compose.quickstart.yml
MLAIR_IMAGE=ml-air:latest
MLAIR_WHEEL_SYNC_DIR=
MLAIR_API_BASE_URL=
MLAIR_WORKER_TOKEN=
MLAIR_ENGINE_VERSION=

# -----------------------------------------------------------------------------
# 11. Image bootstrap credentials (Compose only — not MLAir application config)
# -----------------------------------------------------------------------------
POSTGRES_USER=mlair
POSTGRES_PASSWORD=mlair
POSTGRES_DB=mlair
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# -----------------------------------------------------------------------------
# 12. Image tags & base image (Compose build/run overrides)
# -----------------------------------------------------------------------------
ML_AIR_PYTHON_BASE_IMAGE=python:3.11-slim
MLAIR_API_IMAGE=ml-air-api:latest
MLAIR_SCHEDULER_IMAGE=ml-air-scheduler:latest
MLAIR_EXECUTOR_IMAGE=ml-air-executor:latest
MLAIR_REALTIME_IMAGE=ml-air-realtime:latest
MLAIR_FRONTEND_IMAGE=ml-air-frontend:latest

# -----------------------------------------------------------------------------
# 13. Test / CI only (not production)
# -----------------------------------------------------------------------------
ML_AIR_RUN_DB_INTEGRATION_TESTS=0

# =============================================================================
# MLAir — deployment contract (L3 groups A–E)
# =============================================================================
#
# **Guide:** docs/configuration.md
# **Infra ports / compose bootstrap:** deploy/.env.infra.example (merge into `.env` for compose)
# **Policy / features:** L4 system_settings (Hub System tab) or MLAIR_PROFILE bundle
#
# Create local env: `mlair start` copies contract + infra examples → `.env`
# Inspect merged profile: `mlair config print`

# --- A. Infrastructure ---
ML_AIR_DATABASE_URL=postgresql://mlair:mlair@postgres:5432/mlair
ML_AIR_REDIS_URL=redis://redis:6379/0
ML_AIR_API_BASE_URL=http://api:8080
MLAIR_PORT=8080

# --- B. Secrets ---
ML_AIR_IDENTITY_JWT_SECRET=mlair-dev-identity-jwt-secret-32bytes-minimum
ML_AIR_BOOTSTRAP_ADMIN_USERNAME=admin
ML_AIR_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
ML_AIR_SA_SCHEDULER_SECRET=mlair-dev-sa-scheduler-secret-change-me
ML_AIR_SA_EXECUTOR_SECRET=mlair-dev-sa-executor-secret-change-me
ML_AIR_SA_YOLO_WORKER_SECRET=mlair-dev-sa-yolo-worker-secret-change-me
ML_AIR_SA_VET_WORKER_SECRET=mlair-dev-sa-vet-worker-secret-change-me
ML_AIR_MANIFEST_SIGNING_KEY=mlair-dev-manifest-signing-key
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key

# --- C. Storage ---
ML_AIR_DATASET_ARTIFACT_ROOT=file:///mlair/artifacts/datasets
ML_AIR_DEFAULT_MODEL_ARTIFACT_ROOT=file:///mlair/artifacts/models

# --- D. Deployment mode ---
MLAIR_PROFILE=development

# Optional all-in-one sidecars (MinIO / Prometheus / Grafana) — off by default.
# Enable in mlair.yaml → infra (recommended) or deploy/.env.infra.example → MLAIR_INFRA_*.
# See docs/configuration.md § Optional infra sidecars.

# --- E. Image / compose ---
MLAIR_IMAGE=ml-air:latest
MLAIR_API_IMAGE=ml-air-api:latest
MLAIR_SCHEDULER_IMAGE=ml-air-scheduler:latest
MLAIR_EXECUTOR_IMAGE=ml-air-executor:latest
MLAIR_FRONTEND_IMAGE=ml-air-frontend:latest
MLAIR_REALTIME_IMAGE=ml-air-realtime:latest
COMPOSE_FILE=deploy/docker-compose.allinone.yml
MLAIR_COMPOSE_FILE=deploy/docker-compose.allinone.yml

# --- Frontend wiring (Next.js; not counted in ~20 server contract) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_MLAIR_REALTIME_WS=ws://localhost:8080/ws
MLAIR_NEXT_INTERNAL_API_URL=http://api:8080

# -------------------------------------------------------------------
# Core service connections
# -------------------------------------------------------------------
ML_AIR_REDIS_URL=redis://redis:6379/0
ML_AIR_DATABASE_URL=postgresql://mlair:mlair@postgres:5432/mlair
ML_AIR_API_BASE_URL=http://api:8080
# API only: Private Network Access preflight (browser → loopback API). Default on.
ML_AIR_CORS_ALLOW_PRIVATE_NETWORK=1
# Default artifact root used when user creates model version
# without explicitly providing artifact_uri.
ML_AIR_DEFAULT_MODEL_ARTIFACT_ROOT=file:///mlair/artifacts/models
# Uploaded dataset CSVs; must be on persistent storage in Docker (volume mount this path).
ML_AIR_DATASET_ARTIFACT_ROOT=file:///mlair/artifacts/datasets

# -------------------------------------------------------------------
# Frontend runtime (optional, for Next.js)
# -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Browser and client-side ``fetch`` use this host for ``/v1/...`` (must be reachable from the user machine; Docker maps API to host :8080).
# Next server: `/v1/*` proxy (`frontend/app/v1/[[...segments]]/route.ts`). Leave empty for host `npm run dev`; compose sets http://api:8080 for the frontend container.
MLAIR_NEXT_INTERNAL_API_URL=
# Browser WebSocket URL for MLAir realtime gateway (host port must match MLAIR_REALTIME_PORT).
NEXT_PUBLIC_MLAIR_REALTIME_WS=ws://localhost:8001
# Optional: pipeline detail page starts with execution gate tools expanded (default: hidden until maintainer clicks Show).
# NEXT_PUBLIC_MLAIR_PIPELINE_EXECUTION_GATE_DEFAULT=open
# Optional: POST JSON { intent, tenant_id, project_id, ... , ts } — Hub vs pipeline train (see docs/api/readiness-and-gating.md)
# NEXT_PUBLIC_MLAIR_TRAIN_TELEMETRY_URL=https://your-collector.example/mlair-train-intent
# NEXT_PUBLIC_MLAIR_TRAIN_TELEMETRY_DEBUG=1
# Runtime config surfaced by GET /v1/runtime-config (can change without rebuilding frontend image).
ML_AIR_ENVIRONMENT=dev
ML_AIR_DEFAULT_TENANT=default
ML_AIR_DEFAULT_PROJECT=default_project
ML_AIR_RUNTIME_API_BASE_URL=
ML_AIR_RUNTIME_REALTIME_BASE_URL=
ML_AIR_FRONTEND_VERSION=
ML_AIR_FRONTEND_COMMIT=
ML_AIR_FEATURE_DATASET_HUB_V2=1
ML_AIR_FEATURE_SCOPE_DEBUG_PANEL=0
# When 1, API mounts GET/PUT .../models/{id}/serving; runtime-config.features.serving_slots_http mirrors this for the UI.
ML_AIR_ENABLE_SERVING_SLOTS_HTTP=0
# Realtime gateway (used by api/scheduler in quickstart compose when enabled)
MLAIR_REALTIME_ENABLED=true
# Optional: auto-expire persisted user scope overrides. 0 disables TTL.
ML_AIR_SCOPE_OVERRIDE_TTL_SECONDS=0

# -------------------------------------------------------------------
# API auth/security
# -------------------------------------------------------------------
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
ML_AIR_TRACKING_TOKEN=maintainer-token

# Optional advanced auth settings
ML_AIR_AUTH_TOKENS_JSON=
ML_AIR_JWT_ISSUER=
ML_AIR_JWT_AUDIENCE=
ML_AIR_JWT_JWKS_URL=
ML_AIR_JWT_JWKS_CACHE_TTL_SECONDS=300

# -------------------------------------------------------------------
# Model promote webhook (API only; optional)
# POST JSON to MLAIR_MODEL_PROMOTE_WEBHOOK_URL with Bearer when a model version is promoted.
# -------------------------------------------------------------------
MLAIR_MODEL_PROMOTE_WEBHOOK_URL=
MLAIR_MODEL_PROMOTE_WEBHOOK_BEARER_TOKEN=
MLAIR_MODEL_PROMOTE_WEBHOOK_TIMEOUT_SECONDS=15

# When unset or 0, promote to production requires approval_status=approved on that version.
# Set to 1 only for local/dev if you want to skip the gate (quickstart compose defaults to 1).
ML_AIR_SKIP_APPROVAL_FOR_PROMOTE=

# -------------------------------------------------------------------
# Replay + manifest hardening
# -------------------------------------------------------------------
ML_AIR_REPLAY_REQUIRE_ARTIFACT_EVIDENCE=1
ML_AIR_REPLAY_REQUIRE_CHECKSUM=0
ML_AIR_REPLAY_REQUIRE_SIGNED_MANIFEST=0
ML_AIR_MANIFEST_SIGNING_KEY=mlair-dev-manifest-signing-key
ML_AIR_MANIFEST_ACTIVE_KEY_ID=v1
ML_AIR_MANIFEST_SIGNING_KEYS_JSON={"v1":"mlair-dev-manifest-signing-key"}
ML_AIR_MANIFEST_KEY_PROVIDER=env
ML_AIR_MANIFEST_MANAGED_KEYS_FILE=deploy/security/manifest-keys.local.json
ML_AIR_MANIFEST_STRICT_KEY_LIFECYCLE=0
ML_AIR_MANIFEST_ALLOWED_KEY_IDS=
ML_AIR_MANIFEST_SIGNING_ALGORITHM=hmac-sha256
ML_AIR_MANIFEST_ED25519_PRIVATE_KEY=
ML_AIR_MANIFEST_ED25519_PRIVATE_KEYS_JSON=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEY=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEYS_JSON=

# -------------------------------------------------------------------
# Executor/plugin tuning (optional)
# -------------------------------------------------------------------
ML_AIR_PLUGIN_TIMEOUT_SECONDS=120
ML_AIR_PLUGIN_RUNNER_MODULE=mlair_runner
ML_AIR_LOG_LEVEL=INFO

# -------------------------------------------------------------------
# External worker execution (optional; requires migration 0011)
# Set ML_AIR_TASK_EXECUTION_MODE=external on API + scheduler for pull/lease workers.
# -------------------------------------------------------------------
ML_AIR_TASK_EXECUTION_MODE=internal
# Dedicated Bearer for POST /v1/tasks/lease|heartbeat|complete|fail (optional).
ML_AIR_WORKER_TOKEN=
ML_AIR_TASK_LEASE_SECONDS=30
ML_AIR_LEASE_REAP_INTERVAL_SECONDS=5
# Scheduler periodic loops
ML_AIR_TRIGGER_POLICY_TICK_SECONDS=30
ML_AIR_DATASET_MATERIALIZATION_TICK_SECONDS=30
# Per tenant/project scope when scheduler calls POST .../datasets/buffer/materialize-scheduled
ML_AIR_DATASET_MATERIALIZATION_TICK_LIMIT=50
# Readiness v2 cutover guard (dataset-scoped GET .../readiness, POST .../readiness/evaluate, GET .../eligibility):
# 0 (default) = version-centric: require explicit dataset_version_id when any materialized version exists
#   (no implicit ORDER BY created_at DESC "latest head"); if zero versions exist, 409 no_materialized_dataset_version.
# 1 = legacy compat: allow implicit latest-head resolution and datasets.current_size when no versions exist.
ML_AIR_READINESS_ALLOW_LEGACY_FALLBACK=0
# When 1, POST .../runs, POST .../pipelines/{id}/run, and pipeline check-readiness require at least one
# readiness row from override_config.inputs or pipeline version config.inputs (same as check_run_readiness).
ML_AIR_REQUIRE_DECLARED_DATASET_INPUTS=0
# When 1 (default in API if unset), POST .../runs/trigger requires dataset_version_id (lifecycle-safe train).
# Set to 0 only to allow implicit latest-version fallback on trigger.
ML_AIR_STRICT_DATASET_VERSION_REQUIRED=1
# When 1 together with ML_AIR_STRICT_DATASET_VERSION_REQUIRED=1, POST .../runs, POST .../pipelines/{id}/run,
# and check-readiness require dataset_version_id even without declared readiness inputs (Phase 1 opt-in).
# Default 0 keeps generic pipelines without a dataset pin working.
ML_AIR_STRICT_DATASET_VERSION_ALL_POST_RUNS=0
# When 1, GET dataset-version (by id), GET download, POST .../runs/trigger (implicit head), and any path using
# get_dataset_version / get_latest_materialized_dataset_version re-hash file:// artifacts and compare to checksum.
# Default 0 avoids extra disk I/O on every read.
ML_AIR_VALIDATE_DATASET_VERSION_CHECKSUM=0
# When 1, lineage ingest uses the historical "default" string for dataset_versions.version when the plugin omits version.
# Default unset / 0: allocate explicit monotonic vN (ignores legacy "default" rows when computing the next vN).
ML_AIR_LINEAGE_LEGACY_DEFAULT_VERSION_LABEL=0
# When 1, log WARNING on implicit dataset-version head resolution (trigger latest-head + readiness legacy latest).
ML_AIR_WARN_IMPLICIT_DATASET_HEAD=0
# When 1, persist semantic realtime envelopes to Postgres (semantic_event_outbox) and mark after Redis publish.
ML_AIR_EVENT_OUTBOX=0
# When >0 and ML_AIR_EVENT_OUTBOX=1, API spawns a background thread every N seconds to republish undelivered rows (single-worker advisory lock).
ML_AIR_EVENT_OUTBOX_DRAIN_INTERVAL_SEC=0
# Semantic HTTP webhooks (same JSON envelope as Redis realtime). Non-empty ML_AIR_WEBHOOK_ALLOWED_HOSTS required to register URLs; delivery when ML_AIR_SEMANTIC_WEBHOOK_DELIVERY=1.
ML_AIR_SEMANTIC_WEBHOOK_DELIVERY=0
ML_AIR_WEBHOOK_ALLOWED_HOSTS=
ML_AIR_SEMANTIC_WEBHOOK_TIMEOUT_SECONDS=10
# Webhook retries (408/425/429/5xx + transport errors). Backoff grows exponentially (cap 5s between attempts).
ML_AIR_SEMANTIC_WEBHOOK_MAX_ATTEMPTS=3
ML_AIR_SEMANTIC_WEBHOOK_RETRY_BACKOFF_MS=250
# When 1, after a successful POST per (event_id, subscription_id), skip further HTTP for that pair (migration 0027).
ML_AIR_SEMANTIC_WEBHOOK_DEDUPE=0
# OpenTelemetry: OTLP gRPC export when ML_AIR_OTEL_ENABLED=1 (api, scheduler, executor, realtime images).
ML_AIR_OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# With quickstart Jaeger profile: docker compose -f deploy/docker-compose.quickstart.yml --profile traces up -d
#   then OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
# OTEL_SERVICE_NAME=mlair-api
# OTEL_EXPORTER_OTLP_INSECURE=1
# Browser Jaeger link on /lifecycle: set ML_AIR_JAEGER_UI_URL to a URL reachable from the user's browser (e.g. http://localhost:16686 with --profile traces).
# ML_AIR_JAEGER_UI_URL=http://localhost:16686

# -------------------------------------------------------------------
# CLI/test helpers (optional)
# -------------------------------------------------------------------
ML_AIR_BASE_URL=http://localhost:8080
ML_AIR_TENANT_ID=default
ML_AIR_PROJECT_ID=default_project
ML_AIR_TENANT=default
ML_AIR_PROJECT=default_project
ML_AIR_TOKEN=maintainer-token
COMPOSE_FILE=deploy/docker-compose.quickstart.yml

# -------------------------------------------------------------------
# Ports (host)
# -------------------------------------------------------------------
ML_AIR_FRONTEND_PORT=38080
ML_AIR_API_PORT=8080
ML_AIR_SCHEDULER_METRICS_PORT=9102
ML_AIR_EXECUTOR_METRICS_PORT=9103
ML_AIR_REDIS_PORT=36379
ML_AIR_POSTGRES_PORT=35432
ML_AIR_MINIO_API_PORT=9000
ML_AIR_MINIO_CONSOLE_PORT=9001
ML_AIR_PROMETHEUS_PORT=39090
ML_AIR_GRAFANA_PORT=33000
# Realtime gateway (host); metrics scraped from ML_AIR_REALTIME_METRICS_PORT
MLAIR_REALTIME_PORT=8001
ML_AIR_REALTIME_METRICS_PORT=9104

# -------------------------------------------------------------------
# Postgres bootstrap
# -------------------------------------------------------------------
POSTGRES_USER=mlair
POSTGRES_PASSWORD=mlair
POSTGRES_DB=mlair

# -------------------------------------------------------------------
# MinIO bootstrap
# -------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword

# -------------------------------------------------------------------
# Grafana bootstrap
# -------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

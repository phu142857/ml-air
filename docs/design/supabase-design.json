{
  "color": {
    "background-primary": {
      "$type": "color",
      "$value": "#121212",
      "$description": "Main page background"
    },
    "text-primary": {
      "$type": "color",
      "$value": "#fafafa",
      "$description": "Primary text content"
    },
    "text-secondary": {
      "$type": "color",
      "$value": "#898989",
      "$description": "Secondary text and descriptions"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#4d4d4d",
      "$description": "Muted text and placeholders"
    },
    "brand-primary": {
      "$type": "color",
      "$value": "#3ecf8e",
      "$description": "Primary brand color for CTAs and highlights"
    },
    "brand-dark": {
      "$type": "color",
      "$value": "#006239",
      "$description": "Darker brand variant for hover states"
    },
    "surface-elevated": {
      "$type": "color",
      "$value": "#242424",
      "$description": "Cards and elevated surfaces"
    }
  },
  "typography": {
    "heading-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Circular",
        "fontSize": "72px",
        "fontWeight": 400,
        "lineHeight": "72px"
      },
      "$description": "Hero headlines"
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Circular",
        "fontSize": "36px",
        "fontWeight": 400,
        "lineHeight": "43.2px"
      },
      "$description": "Section headings"
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Circular",
        "fontSize": "24px",
        "fontWeight": 400,
        "lineHeight": "32px",
        "letterSpacing": "-0.16px"

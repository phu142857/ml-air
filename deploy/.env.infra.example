# =============================================================================
# MLAir — compose infrastructure (merged into project-root `.env` on first `mlair start`)
# =============================================================================
#
# **Edit `ml-air/.env` only** — do not copy this file into `deploy/` or maintain a separate deploy/.env.
# `mlair` passes `--env-file <repo-root>/.env` to Docker Compose automatically (project dir stays `deploy/`).
#
# Host ports, image bootstrap credentials, scheduler/executor tuning, and transitional secrets.
# Policy / feature flags: L4 system_settings (Hub System tab) or MLAIR_PROFILE.

# -----------------------------------------------------------------------------
# Optional all-in-one sidecars (OFF by default)
# -----------------------------------------------------------------------------
# `mlair start` runs only the all-in-one `mlair` container unless sidecars are enabled.
# Recommended: copy mlair.yaml.example → mlair.yaml and set `infra.minio` / `prometheus` / `grafana`.
# The CLI sets COMPOSE_PROFILES and MLAIR_INFRA_* from that config on each start.
#
# Env-only override (when not using mlair.yaml):
MLAIR_INFRA_MINIO=0
MLAIR_INFRA_PROMETHEUS=0
MLAIR_INFRA_GRAFANA=0
# COMPOSE_PROFILES=minio,prometheus,grafana
#
# Hub links / scripts when Grafana is enabled (set ML_AIR_GRAFANA_URL or observability.grafana_url):
# ML_AIR_GRAFANA_URL=http://localhost:33000
# ML_AIR_PROMETHEUS_URL=http://localhost:39090

# -----------------------------------------------------------------------------
# Host ports (Docker Compose → host)
# -----------------------------------------------------------------------------
ML_AIR_FRONTEND_PORT=38080
ML_AIR_API_PORT=8080
ML_AIR_SCHEDULER_METRICS_PORT=9102
ML_AIR_EXECUTOR_METRICS_PORT=9103
ML_AIR_REDIS_PORT=36379
ML_AIR_POSTGRES_PORT=35432
ML_AIR_MINIO_API_PORT=9000
ML_AIR_MINIO_CONSOLE_PORT=9001
ML_AIR_PROMETHEUS_PORT=39090
ML_AIR_GRAFANA_PORT=33000
MLAIR_REALTIME_PORT=8001
ML_AIR_REALTIME_METRICS_PORT=9104

# -----------------------------------------------------------------------------
# Legacy auth (migration-only — not in target contract)
# -----------------------------------------------------------------------------
ML_AIR_LEGACY_STATIC_TOKENS=0
ML_AIR_TRACKING_TOKEN=
ML_AIR_AUTH_TOKENS_JSON=
ML_AIR_JWT_ISSUER=
ML_AIR_JWT_AUDIENCE=
ML_AIR_JWT_JWKS_URL=
ML_AIR_JWT_JWKS_CACHE_TTL_SECONDS=300
ML_AIR_WORKER_TOKEN=

# -----------------------------------------------------------------------------
# Manifest / signing (extended)
# -----------------------------------------------------------------------------
ML_AIR_MANIFEST_ACTIVE_KEY_ID=v1
ML_AIR_MANIFEST_SIGNING_KEYS_JSON={"v1":"mlair-dev-manifest-signing-key"}
ML_AIR_MANIFEST_KEY_PROVIDER=env
ML_AIR_MANIFEST_MANAGED_KEYS_FILE=deploy/security/manifest-keys.local.json
ML_AIR_MANIFEST_STRICT_KEY_LIFECYCLE=1
ML_AIR_MANIFEST_ALLOWED_KEY_IDS=
ML_AIR_MANIFEST_SIGNING_ALGORITHM=hmac-sha256
ML_AIR_MANIFEST_ED25519_PRIVATE_KEY=
ML_AIR_MANIFEST_ED25519_PRIVATE_KEYS_JSON=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEY=
ML_AIR_MANIFEST_ED25519_PUBLIC_KEYS_JSON=

# Semantic realtime envelopes (Redis → Hub WebSocket). Signing defaults ON.
# Primary keys ML_AIR_SEMANTIC_EVENT_SIGNING / _SIGNING_KEY live in project-root `.env.example`.
# Optional rotation / validate toggles (compose-forwarded):
ML_AIR_SEMANTIC_EVENT_SIGNING_KEYS_JSON=
ML_AIR_SEMANTIC_EVENT_VALIDATE=0
# ML_AIR_SEMANTIC_EVENT_ACTIVE_KEY_ID=v1

# -----------------------------------------------------------------------------
# Observability & logging
# -----------------------------------------------------------------------------
ML_AIR_LOG_LEVEL=INFO
ML_AIR_OTEL_ENABLED=1
OTEL_SERVICE_NAME_SCHEDULER=mlair-scheduler
OTEL_SERVICE_NAME_EXECUTOR=mlair-executor
OTEL_SERVICE_NAME_REALTIME=mlair-realtime

# -----------------------------------------------------------------------------
# Scheduler / executor / realtime tuning
# -----------------------------------------------------------------------------
ML_AIR_ENVIRONMENT=development
# ML_AIR_TASK_EXECUTION_MODE / ML_AIR_TASK_LEASE_SECONDS live in project-root `.env.example`.
ML_AIR_LEASE_REAP_INTERVAL_SECONDS=5
ML_AIR_USAGE_TRACKING_ENABLED=1
ML_AIR_RESOURCE_MONITOR_ENABLED=1
ML_AIR_RESOURCE_SAMPLE_INTERVAL=1
ML_AIR_RESOURCE_FLUSH_INTERVAL=1
# Replay governance: checksum + signed manifest → L4 system_settings (rollback: ML_AIR_CONFIG_ACCEPT_POLICY_ENV=1)
ML_AIR_REPLAY_REQUIRE_ARTIFACT_EVIDENCE=1
# Browser-facing realtime (GET /v1/runtime-config → Hub WS). Leave empty for same-origin inference.
ML_AIR_RUNTIME_REALTIME_BASE_URL=
ML_AIR_RUNTIME_REALTIME_DEFAULT_URL=
# Optional explicit override (remote VM, TLS, or split ingress):
# ML_AIR_RUNTIME_API_BASE_URL=http://192.168.x.x:8080
# ML_AIR_RUNTIME_REALTIME_BASE_URL=ws://192.168.x.x:8080/ws
# ML_AIR_RUNTIME_REALTIME_BASE_URL=wss://mlair.example.com/ws
MLAIR_MODEL_PROMOTE_WEBHOOK_URL=
MLAIR_MODEL_PROMOTE_WEBHOOK_BEARER_TOKEN=
MLAIR_MODEL_PROMOTE_WEBHOOK_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Run environment capture
# -----------------------------------------------------------------------------
ML_AIR_DOCKER_IMAGE=
MLAIR_SOURCE_COMMIT=
MLAIR_SOURCE_BRANCH=

# -----------------------------------------------------------------------------
# Image bootstrap (Compose services — not MLAir application contract)
# Used only when the matching infra sidecar profile is enabled (see above).
# -----------------------------------------------------------------------------
POSTGRES_USER=mlair
POSTGRES_PASSWORD=mlair
POSTGRES_DB=mlair
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
ML_AIR_PYTHON_BASE_IMAGE=python:3.11-slim

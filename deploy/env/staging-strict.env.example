# Staging strict lifecycle overlay (M1 / Wave 0b)
# Merge after .env.example + deploy/.env.infra.example:
#   cat .env.example deploy/.env.infra.example deploy/env/staging-strict.env.example > .env
# See docs/runbooks/production-strict-lifecycle.md

MLAIR_PROFILE=staging
ML_AIR_ENVIRONMENT=staging

# Strict dataset pins + readiness (maps to runtime-config.features.*)
ML_AIR_STRICT_DATASET_VERSION_REQUIRED=1
ML_AIR_STRICT_DATASET_VERSION_ALL_POST_RUNS=1
ML_AIR_READINESS_ALLOW_LEGACY_FALLBACK=0

# Observe implicit-head callers during M1; set 0 after sign-off
ML_AIR_WARN_IMPLICIT_DATASET_HEAD=1
ML_AIR_LINEAGE_LEGACY_DEFAULT_VERSION_LABEL=0

# Enable when all pipelines declare dataset inputs
ML_AIR_REQUIRE_DECLARED_DATASET_INPUTS=0

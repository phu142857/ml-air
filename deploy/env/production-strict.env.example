# Production strict lifecycle overlay
# Merge into secret manager / Helm values / .env for production deploy.
# See docs/runbooks/production-strict-lifecycle.md

MLAIR_PROFILE=production
ML_AIR_ENVIRONMENT=production

ML_AIR_STRICT_DATASET_VERSION_REQUIRED=1
ML_AIR_STRICT_DATASET_VERSION_ALL_POST_RUNS=1
ML_AIR_READINESS_ALLOW_LEGACY_FALLBACK=0

ML_AIR_WARN_IMPLICIT_DATASET_HEAD=0
ML_AIR_LINEAGE_LEGACY_DEFAULT_VERSION_LABEL=0
ML_AIR_REQUIRE_DECLARED_DATASET_INPUTS=0

# Production WSS — set to browser-reachable URL (see docs/runbooks/production-wss-ingress.md)
# ML_AIR_RUNTIME_REALTIME_BASE_URL=wss://mlair.example.com/ws

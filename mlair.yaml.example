# Optional local overrides — copy to mlair.yaml and edit.
# Sensible defaults apply when this file is absent (profile: development).
# Full reference: docs/configuration.md
#
# All features default to ON in profiles and code. Set feature keys to false to disable.
# Infra sidecars (MinIO / Prometheus / Grafana) default to OFF.

profile: development

